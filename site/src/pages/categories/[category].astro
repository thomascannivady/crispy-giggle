---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { slugify } from '../../utils/slug';

export async function getStaticPaths() {
  const entries = await getCollection('reviews', ({ data }) => {
    return import.meta.env.DEV || data.draft === false;
  });

  const byCategory = new Map<string, typeof entries>();
  for (const entry of entries) {
    const list = byCategory.get(entry.data.category) ?? [];
    list.push(entry);
    byCategory.set(entry.data.category, list);
  }

  return Array.from(byCategory.entries()).map(([category, categoryEntries]) => ({
    params: { category: slugify(category) },
    props: { category, entries: categoryEntries },
  }));
}

const { category, entries } = Astro.props;
entries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title={`${category} guides — Home Cook House`}
  description={`Independent, hands-on ${category.toLowerCase()} product comparisons and buying guides.`}
>
  <h1>{category} guides</h1>

  <ul class="post-list">
    {entries.map((entry) => (
      <li>
        <a href={`/reviews/${entry.id}/`}>{entry.data.title}</a>
        <p>{entry.data.description}</p>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1.5rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .post-list a {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: underline;
    color: inherit;
  }
  .post-list p {
    opacity: 0.7;
    margin: 0.25rem 0 0;
  }
</style>
